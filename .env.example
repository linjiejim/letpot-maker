# Optional: enables AI Generate in Maker Studio through any provider that
# supports the standard OpenAI chat-completions messages format.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Example values (choose your own compatible provider and model):
# AI_BASE_URL=https://api.minimax.io/v1
# AI_MODEL=MiniMax-M3
# MiniMax coding-plan keys issued in China use https://api.minimaxi.com/v1.
# AI_BASE_URL=https://api.kimi.com/coding/v1
# AI_MODEL=k3-256k

# Docker Compose defaults. Keep 127.0.0.1 when a reverse proxy or VPN is used.
LETPOT_BIND_ADDRESS=127.0.0.1
LETPOT_PORT=3000
LETPOT_IMAGE=letpot-maker:local
